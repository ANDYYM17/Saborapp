<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SaborApp.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Icono con Contenedor Circular -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconMesa"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/status_libre_bg"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/status_libre_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivMesaIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_desc_icon"
                android:padding="10dp"
                android:src="@drawable/ic_table"
                app:tint="@color/status_libre" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNumeroMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Mesa 1" />

        <TextView
            android:id="@+id/tvCapacidadMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="4 personas" />

        <TextView
            android:id="@+id/tvEstadoMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_libre"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/status_libre"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="LIBRE" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
